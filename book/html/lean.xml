<?xml version="1.0" encoding="UTF-8"?>
<!-- A small Kate-style syntax definition for Lean 4, used by pandoc
     (the syntax-definition option, see build.sh) so that ```lean blocks are highlighted at
     build time. It covers what the book's code uses: keywords, tactics, types,
     comments (nested block comments too), strings, numbers, attributes and the
     usual Unicode symbols. It is not a full Lean grammar. -->
<language name="Lean" version="1" kateversion="5.0" section="Sources" extensions="*.lean" mimetype="text/x-lean" author="book" license="MIT">
  <highlighting>
    <list name="keywords">
      <item>abbrev</item>
      <item>axiom</item>
      <item>by</item>
      <item>calc</item>
      <item>class</item>
      <item>def</item>
      <item>deriving</item>
      <item>do</item>
      <item>else</item>
      <item>end</item>
      <item>example</item>
      <item>exact</item>
      <item>extends</item>
      <item>fun</item>
      <item>have</item>
      <item>if</item>
      <item>import</item>
      <item>in</item>
      <item>inductive</item>
      <item>instance</item>
      <item>lemma</item>
      <item>let</item>
      <item>local</item>
      <item>macro</item>
      <item>match</item>
      <item>namespace</item>
      <item>noncomputable</item>
      <item>notation</item>
      <item>open</item>
      <item>opaque</item>
      <item>private</item>
      <item>protected</item>
      <item>section</item>
      <item>show</item>
      <item>structure</item>
      <item>then</item>
      <item>theorem</item>
      <item>universe</item>
      <item>variable</item>
      <item>where</item>
      <item>with</item>
    </list>
    <list name="tactics">
      <item>apply</item>
      <item>assumption</item>
      <item>cases</item>
      <item>constructor</item>
      <item>exact</item>
      <item>field_simp</item>
      <item>gcongr</item>
      <item>induction</item>
      <item>intro</item>
      <item>intros</item>
      <item>linarith</item>
      <item>nlinarith</item>
      <item>norm_num</item>
      <item>obtain</item>
      <item>positivity</item>
      <item>push_cast</item>
      <item>refine</item>
      <item>rcases</item>
      <item>rfl</item>
      <item>rintro</item>
      <item>rw</item>
      <item>simp</item>
      <item>sorry</item>
      <item>specialize</item>
      <item>use</item>
    </list>
    <list name="types">
      <item>Bool</item>
      <item>Complex</item>
      <item>Fin</item>
      <item>Finset</item>
      <item>Int</item>
      <item>List</item>
      <item>Nat</item>
      <item>Option</item>
      <item>Prop</item>
      <item>Real</item>
      <item>Set</item>
      <item>Sort</item>
      <item>String</item>
      <item>Type</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="LineComment" char="-" char1="-"/>
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="-"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <RegExpr attribute="Attribute" context="#stay" String="@\[[^\]]*\]"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Control Flow" context="#stay" String="tactics"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <Float attribute="Float" context="#stay"/>
        <Int attribute="Decimal" context="#stay"/>
        <AnyChar attribute="Data Type" context="#stay" String="ℝℕℤℚℂ"/>
        <AnyChar attribute="Operator" context="#stay" String="∀∃λ→←↔∧∨¬≤≥≠≈∈∉⊆∑∏∫‖•×·∘⟨⟩∞√∣"/>
        <AnyChar attribute="Operator" context="#stay" String=":=+*/&lt;&gt;^|&amp;"/>
      </context>
      <context name="LineComment" attribute="Comment" lineEndContext="#pop"/>
      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="-"/>
        <Detect2Chars attribute="Comment" context="#pop" char="-" char1="/"/>
      </context>
      <context name="String" attribute="String" lineEndContext="#stay">
        <Detect2Chars attribute="String Char" context="#stay" char="\" char1="\"/>
        <Detect2Chars attribute="String Char" context="#stay" char="\" char1="&quot;"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Control Flow" defStyleNum="dsControlFlow"/>
      <itemData name="Data Type" defStyleNum="dsDataType"/>
      <itemData name="Decimal" defStyleNum="dsDecVal"/>
      <itemData name="Float" defStyleNum="dsFloat"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="String Char" defStyleNum="dsSpecialChar"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
      <itemData name="Attribute" defStyleNum="dsAttribute"/>
      <itemData name="Operator" defStyleNum="dsOperator"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="singleLine" start="--"/>
      <comment name="multiLine" start="/-" end="-/"/>
    </comments>
    <keywords casesensitive="1" weakDeliminator="._'"/>
  </general>
</language>
